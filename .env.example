# =================================================================
# DokuTV_EN Environment Configuration
# Kopieren Sie diese Datei zu `.env` und tragen Sie Ihre Keys ein.
# =================================================================

# 1. Google Cloud YouTube Data API v3 Key
# Erforderlich für die automatische Suche nach echten CC-BY Dokumentationen.
YOUTUBE_API_KEY=AIzaSyYourActualGoogleCloudYouTubeApiKeyHere

# 2. Twitch Stream Key (Kanal: DokuTV_EN)
# Erforderlich für das echte 24/7 RTMP Streaming an Twitch.
# Zu finden unter: https://dashboard.twitch.tv/u/dokutv_en/settings/stream
TWITCH_STREAM_KEY=live_123456789_YourActualTwitchStreamKeyHere

# 3. Twitch Application Credentials (für AUTOMATISCHE OAuth Token-Generierung!)
# Erstellen Sie eine App auf: https://dev.twitch.tv/console/apps
# Das System generiert und erneuert das Token vollautomatisch im Hintergrund!
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# 4. YouTube Authentifizierung / Cookie-Einstellungen (Optional, gegen Bot-Checks)
# YOUTUBE_COOKIES_FILE=cookies.txt
# YOUTUBE_COOKIES_BROWSER=chrome

# 5. Python-Einstellungen
# Verhindert die Erstellung von __pycache__ Bytecode-Dateien im Projekt.    
PYTHONDONTWRITEBYTECODE=1
